# Local runs read this file (copy to .env). On Fly, use `fly secrets set` instead.
ANTHROPIC_API_KEY=
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=

# Optional: ping your phone after each cycle (ntfy.sh topic URL, Slack or Discord webhook).
NOTIFY_URL=

# Optional: LinkedIn job alert emails. Use ONE of these.
# Option A, Gmail API (read-only scope); get the refresh token with `autoapply gmail-auth`.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Option B, IMAP with a Google app password (needs 2-step verification on the account).
IMAP_USER=
IMAP_PASSWORD=
