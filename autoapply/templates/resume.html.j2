<!doctype html>
<html>
<head>
<meta charset="utf-8">
<style>
  @page { size: {{ paper }}; margin: 0.4in 0.5in; }
  * { box-sizing: border-box; }
  body { font-family: "Helvetica Neue", Helvetica, Arial, sans-serif; color: #222; font-size: {{ font_pt }}pt; line-height: {{ line_height }}; margin: 0; }
  h1 { text-align: center; color: #1f4e79; font-size: 24pt; margin: 0 0 2pt; letter-spacing: 0.2pt; }
  .contact { text-align: center; font-size: 9.5pt; color: #333; margin-bottom: 6pt; }
  .contact a { color: #1f4e79; }
  h2 { color: #1f4e79; font-size: 11pt; text-transform: uppercase; margin: 7pt 0 2pt; padding-bottom: 1pt; border-bottom: 1.2pt solid #1f4e79; letter-spacing: 0.3pt; }
  .row { display: flex; justify-content: space-between; align-items: baseline; margin-top: 4pt; }
  .row .left { font-weight: bold; }
  .row .company { color: #1f4e79; }
  .row .loc { font-weight: normal; color: #555; }
  .row .dates { font-style: italic; color: #333; white-space: nowrap; margin-left: 12pt; }
  ul { margin: 1.5pt 0 0 0; padding-left: 15pt; }
  li { margin: 0 0 1.5pt; }
  .sub { color: #444; }
  .skills div { margin: 1pt 0; }
  .summary { margin: 0; }
  a { color: inherit; text-decoration: underline; }
</style>
</head>
<body>
  <h1>{{ p.personal.full_name }}</h1>
  <div class="contact">{{ contact | join(Markup("&nbsp; | &nbsp;")) }}</div>

  {% if r.summary %}
  <h2>Summary</h2>
  <p class="summary">{{ r.summary }}</p>
  {% endif %}

  <h2>Experience</h2>
  {% for role in r.experience %}
  <div class="row">
    <div class="left">{{ role.title }} &middot; <span class="company">{{ role.company }}</span>{% if role.location %} <span class="loc">&middot; {{ role.location }}</span>{% endif %}</div>
    <div class="dates">{{ role.start }} – {{ role.end }}</div>
  </div>
  <ul>{% for b in role.bullets %}<li>{{ b.text }}</li>{% endfor %}</ul>
  {% endfor %}

  {% if r.projects %}
  <h2>Projects</h2>
  {% for proj in r.projects %}
  <div class="row">
    <div class="left">{{ proj.name }}{% if proj.url %} <span class="loc"><a href="{{ proj.url }}">{{ proj.url | display_url }}</a></span>{% endif %}</div>
    <div class="dates">{{ proj.dates }}</div>
  </div>
  <ul>{% for b in proj.bullets %}<li>{{ b.text }}</li>{% endfor %}</ul>
  {% endfor %}
  {% endif %}

  {% if p.education %}
  <h2>Education</h2>
  {% for ed in p.education %}
  <div class="row">
    <div class="left">{{ ed.school }}</div>
    <div class="dates">{% if ed.start %}{{ ed.start }} – {% endif %}{% if ed.end %}{{ "Graduated " if not ed.start }}{{ ed.end }}{% endif %}</div>
  </div>
  <div class="sub">{{ ed.degree }}{% if ed.details %} &middot; {{ ed.details }}{% endif %}{% if ed.gpa %} &middot; GPA {{ ed.gpa }}{% endif %}</div>
  {% endfor %}
  {% endif %}

  {% if r.skills %}
  <h2>Skills</h2>
  <div class="skills">
    {% for g in r.skills if g.items %}<div><b>{{ g.name }}:</b> {{ g.items | join(", ") }}</div>{% endfor %}
  </div>
  {% endif %}
</body>
</html>
