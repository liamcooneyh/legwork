<!doctype html>
<html>
<head>
<meta charset="utf-8">
<style>
  @page { size: {{ paper }}; margin: 0.55in 0.65in; }
  * { box-sizing: border-box; }
  body { font-family: "Charter", "Bitstream Charter", "Georgia", "Liberation Serif", serif; color: #111; font-size: {{ font_pt }}pt;
         line-height: {{ line_height }}; margin: 0; }
  h1 { font-size: 21pt; font-weight: normal; letter-spacing: 1.5pt; text-align: center; margin: 0 0 3pt; }
  .contact { text-align: center; font-size: 0.92em; color: #333; margin-bottom: 4pt; }
  .contact a { color: inherit; text-decoration: none; }
  h2 { font-size: 0.95em; font-weight: bold; font-variant: small-caps; letter-spacing: 1pt; margin: 9pt 0 3pt;
       padding-bottom: 1.5pt; border-bottom: 0.6pt solid #111; }
  .row { display: flex; justify-content: space-between; align-items: baseline; }
  .role { margin-top: 5pt; }
  .company { font-weight: bold; }
  .muted { color: #444; }
  .dates { white-space: nowrap; margin-left: 12pt; color: #333; }
  .title { font-style: normal; }
  ul { margin: 1.5pt 0 0; padding-left: 14pt; }
  li { margin: 0 0 1.5pt; }
  li, p { text-wrap: pretty; }
  p.summary { margin: 0; }
  .skills div { margin: 1pt 0; }
</style>
</head>
<body>
  <h1>{{ p.personal.full_name }}</h1>
  <div class="contact">{{ contact | join(Markup("&nbsp; · &nbsp;")) }}</div>

  {% if r.summary %}<h2>Summary</h2><p class="summary">{{ r.summary }}</p>{% endif %}

  <h2>Experience</h2>
  {% for role in r.experience %}
  <div class="role">
    <div class="row">
      <div>{% if role.company %}<span class="company">{{ role.company }}</span>{% if role.location %}<span class="muted">, {{ role.location }}</span>{% endif %}{% else %}<span class="company">{{ role.title }}</span>{% endif %}</div>
      <div class="dates">{{ role.earlier_titles[-1].start if role.earlier_titles else role.start }} – {{ role.end }}</div>
    </div>
    {% if role.company %}<div class="title">{% for t in role.earlier_titles | reverse %}{{ t.title }} &rarr; {% endfor %}{{ role.title }}</div>{% endif %}
    {% if role.bullets %}<ul>{% for b in role.bullets %}<li>{{ b.text }}</li>{% endfor %}</ul>{% endif %}
  </div>
  {% endfor %}

  {% if r.projects %}
  <h2>Projects</h2>
  {% for proj in r.projects %}
  <div class="role">
    <div class="row">
      <div><span class="company">{{ proj.name }}</span>{% if proj.url %}<span class="muted">, {{ proj.url | display_url }}</span>{% endif %}</div>
      <div class="dates">{{ proj.dates }}</div>
    </div>
    <ul>{% for b in proj.bullets %}<li>{{ b.text }}</li>{% endfor %}</ul>
  </div>
  {% endfor %}
  {% endif %}

  {% if r.skills %}
  <h2>Skills</h2>
  <div class="skills">{% for g in r.skills if g.items %}<div><b>{{ g.name }}:</b> {{ g.items | join(", ") }}</div>{% endfor %}</div>
  {% endif %}

  {% if p.education %}
  <h2>Education</h2>
  {% for ed in p.education %}
  <div class="row"><div><span class="company">{{ ed.school }}</span></div><div class="dates">{{ ed.end }}</div></div>
  <div>{{ ed.degree }}{% if ed.details %}; {{ ed.details }}{% endif %}{% if ed.gpa %}; GPA {{ ed.gpa }}{% endif %}</div>
  {% endfor %}
  {% endif %}
</body>
</html>
