<!doctype html>
<html>
<head>
<meta charset="utf-8">
<style>
  @page { size: {{ paper }}; margin: 0.5in 0.6in; }
  * { box-sizing: border-box; }
  body { font-family: "Helvetica Neue", Helvetica, "Liberation Sans", Arial, sans-serif; color: #222; font-size: {{ font_pt }}pt;
         line-height: {{ line_height }}; margin: 0; }
  h1 { text-align: {{ 'left' if opt.header_left else 'center' }}; color: #1f3a5f; font-size: 22pt; margin: 0 0 2pt; letter-spacing: 0.2pt; }
  .contact { text-align: {{ 'left' if opt.header_left else 'center' }}; font-size: 0.92em; color: #444; margin-bottom: 4pt; }
  .role-title { margin-top: 0.5pt; }
  .strip { margin-top: 3pt; }
  .contact a { color: inherit; text-decoration: none; }
  h2 { color: #1f3a5f; font-size: 0.95em; text-transform: uppercase; letter-spacing: 0.8pt; margin: 9pt 0 3pt;
       padding-bottom: 1.5pt; border-bottom: 1pt solid #1f3a5f; }
  .row { display: flex; justify-content: space-between; align-items: baseline; margin-top: 5pt; }
  .left b { font-weight: bold; }
  .muted { color: #555; }
  .dates { white-space: nowrap; margin-left: 12pt; color: #555; }
  ul { margin: 1.5pt 0 0; padding-left: 14pt; }
  li { margin: 0 0 1.5pt; }
  li, p { text-wrap: pretty; }
  p.summary { margin: 0; }
  .skills div { margin: 1pt 0; }
</style>
</head>
<body>
  <h1>{{ p.personal.full_name }}</h1>
  <div class="contact">{{ contact | join(Markup("&nbsp; | &nbsp;")) }}</div>

  {% if r.summary %}<h2>Summary</h2><p class="summary">{{ r.summary }}</p>{% endif %}
  {% if opt.skills_strip and r.skills %}<div class="strip"><b>Core skills:</b> {{ r.skills | map(attribute='items') | map('join', ', ') | join(', ') }}</div>{% endif %}

  <h2>Experience</h2>
  {% for role in r.experience %}
  {% set titles %}{% for t in role.earlier_titles | reverse %}{{ t.title }} &rarr; {% endfor %}{{ role.title }}{% endset %}
  <div class="row">
    {% if opt.company_first and role.company %}
    <div class="left"><b>{{ role.company }}</b>{% if role.location %} <span class="muted">· {{ role.location }}</span>{% endif %}</div>
    {% else %}
    <div class="left"><b>{{ titles }}</b>{% if role.company %} · {{ role.company }}{% endif %}{% if role.location %} <span class="muted">· {{ role.location }}</span>{% endif %}</div>
    {% endif %}
    <div class="dates">{{ role.earlier_titles[-1].start if role.earlier_titles else role.start }} – {{ role.end }}</div>
  </div>
  {% if opt.company_first and role.company %}<div class="role-title">{{ titles }}</div>{% endif %}
  {% if role.bullets %}<ul>{% for b in role.bullets %}<li>{{ b.text }}</li>{% endfor %}</ul>{% endif %}
  {% endfor %}

  {% if r.projects %}
  <h2>Projects</h2>
  {% for proj in r.projects %}
  <div class="row">
    <div class="left"><b>{{ proj.name }}</b>{% if proj.url %} <span class="muted">· {{ proj.url | display_url }}</span>{% endif %}</div>
    <div class="dates">{{ proj.dates }}</div>
  </div>
  <ul>{% for b in proj.bullets %}<li>{{ b.text }}</li>{% endfor %}</ul>
  {% endfor %}
  {% endif %}

  {% if r.skills and not opt.skills_strip %}
  <h2>Skills</h2>
  <div class="skills">{% for g in r.skills if g.items %}<div><b>{{ g.name }}:</b> {{ g.items | join(", ") }}</div>{% endfor %}</div>
  {% endif %}

  {% if p.education %}
  <h2>Education</h2>
  {% for ed in p.education %}
  <div class="row"><div class="left"><b>{{ ed.school }}</b></div><div class="dates">{{ ed.end }}</div></div>
  <div>{{ ed.degree }}{% if ed.details %} · {{ ed.details }}{% endif %}{% if ed.gpa %} · GPA {{ ed.gpa }}{% endif %}</div>
  {% endfor %}
  {% endif %}
</body>
</html>
